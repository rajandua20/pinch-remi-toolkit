{
  "name": "@pinch-remi/pinch-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Pinch Payments API (Australia) — read tools, guarded write tools, and a dishonour-diagnosis map for AI payments agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pinch-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
