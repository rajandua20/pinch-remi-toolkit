# --- Pinch credentials (https://web.getpinch.com.au/api-keys) ---------------
# Merchant ID (mch_...) or Application ID, plus the matching Secret Key (sk_...).
# The SAME credentials work in test and live — PINCH_ENV selects the environment.
PINCH_MERCHANT_ID=mch_xxxxxxxxxxxxxxxx
PINCH_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "test" (sandbox, default) or "live" (real money!)
PINCH_ENV=test

# --- Optional ---------------------------------------------------------------
# Managed merchants: act on behalf of a sub-merchant (sent as Current-Merchant header).
# PINCH_CURRENT_MERCHANT=mch_xxxxxxxxxxxxxxxx

# Sandbox time travel: fast-forward overnight direct-debit processing (test env only).
# RFC3339 UTC timestamp, sent as the Time-Travel header on every request.
# PINCH_TIME_TRAVEL=2026-07-25T09:00:00Z

# Safety cap for pinch_create_refund, in integer cents (default 20000 = $200.00).
# PINCH_MAX_REFUND_CENTS=20000

# returnUrl used when creating payment links (Pinch requires one; it appends
# paymentLinkId + paymentId query params on redirect).
# PINCH_RETURN_URL=https://your-site.example/payments/thanks
